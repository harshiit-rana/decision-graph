# Copy to .env, or just run `dg init` and it will write this for you.
#
# Read automatically by every dg command. You never export these by hand.

# Required. Unauthenticated GitHub allows 60 requests/hour, which cannot finish a
# backfill. A public repo needs no scopes at all — a classic token with nothing ticked
# is enough. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Default repository for `dg ingest`. Override per run with --repo owner/name.
TARGET_REPO=pallets/flask

# How far back to ingest.
BACKFILL_MONTHS=12

# NOTE: DATABASE_URL is deliberately NOT here. The database lives at a fixed address on
# the Docker network and docker-compose.yml injects it. Setting it in this file has no
# effect.

# Written by `dg init`: a random password for the database superuser, replacing the public
# fallback `dg`. Leave it blank here and let init generate it, because init also changes
# the password inside the database. Editing this line alone does not change the database's
# password; it only locks `dg` out until the two match again (see README, "When something
# breaks").
DG_DB_PASSWORD=

# Optional. The published database port listens on 127.0.0.1 only. Set this to 0.0.0.0
# only if another machine must connect, and understand that it can then rewrite the graph.
# DG_DB_BIND=127.0.0.1
# DG_DB_PORT=55434

# Optional, and only for `dg ask` -- the plain-English front door to the same engines
# `dg query` uses. It calls meta/llama-3.1-70b-instruct through Nvidia NIM, so the question
# and the traversal paths leave your machine; every other command talks to GitHub and your
# own database and nothing else. Get a key at https://build.nvidia.com
#
# Leave it blank and everything except `dg ask` works. `dg doctor` warns if it is missing
# rather than letting you find out after typing a question.
NVIDIA_API_KEY=

# Optional. Which model `dg ask` calls. A hosted model id is not a constant -- it has an
# end-of-life date the code cannot see -- and the previous default was retired on
# 2026-08-26, which broke `dg ask` with a 410. Set this to any id from
# https://build.nvidia.com to move off a retired model without editing code or rebuilding.
# Default: nvidia/nemotron-3-super-120b-a12b
DG_NLP_MODEL=
